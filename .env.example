# LLM provider: openai or gemini.
# Copy this file to .env locally and fill real values.
CLOUD_LLM_PROVIDER=gemini

# Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI-compatible cloud LLM endpoint.
CLOUD_LLM_API_URL=https://api.openai.com/v1/chat/completions
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=gpt-4o-mini

# Retrieval settings.
RAG_INDEX_PATH=indexes/vector_index.json
RAG_TOP_K=4
RAG_MIN_SCORE=0.10
